<%
require 'ipaddr'
require 'cgi'
%>
<% if !connect.host_ip || !connect.node_port || !connect.token || !connect.interface_path %>
<p>Jupyter is initializing. Refresh this session card shortly.</p>
<% else %>
<%
host_ip = IPAddr.new(connect.host_ip.to_s).to_s
allowed_host = Regexp.new("\\A(?:#{ENV.fetch('OOD_NODE_HOST_REGEX')})\\z")
raise 'Unexpected node address' unless allowed_host.match?(host_ip)
node_port = Integer(connect.node_port.to_s, 10)
raise 'Invalid NodePort' unless (1..65535).cover?(node_port)
token = connect.token.to_s
raise 'Invalid session token' unless token.match?(/\A[0-9a-f]{64}\z/)
interface_path = connect.interface_path.to_s
raise 'Invalid Jupyter interface' unless %w[lab tree].include?(interface_path)
url = "/node/#{host_ip}/#{node_port}/#{interface_path}?token=#{token}"
%>
<a class="btn btn-primary" href="<%= CGI.escapeHTML(url) %>" target="_blank" rel="noopener noreferrer">Connect to Jupyter</a>
<% end %>

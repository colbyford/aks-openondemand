<%
require 'yaml'
require 'securerandom'
require 'fileutils'
cores = [[Integer(cpu.to_s, 10), 1].max, 4].min
gib = [[Integer(memory.to_s, 10), 1].max, 8].min
seconds = [[Integer(hours.to_s, 10), 1].max, 24].min * 3600
mode = interface.to_s
raise 'Invalid Jupyter interface' unless %w[lab notebook].include?(mode)
root = staged_root.to_s
raise 'Invalid session path' unless root.match?(%r{\A/home/ondemand/[A-Za-z0-9_./-]+\z}) && !root.split('/').include?('..')
image = ENV.fetch('OOD_JUPYTER_IMAGE')
raise 'Invalid runtime image' unless image.match?(%r{\A[a-zA-Z0-9][a-zA-Z0-9._/:@-]+\z})
origin = ENV.fetch('OOD_PORTAL_ORIGIN')
raise 'Invalid portal origin' unless origin.match?(%r{\Ahttps://[A-Za-z0-9.-]+(?::\d{1,5})?\z})
FileUtils.mkdir_p(root, mode: 0700)
token = SecureRandom.hex(32)
File.open(File.join(root, 'token'), File::WRONLY | File::CREAT | File::TRUNC, 0600) { |f| f.write(token) }
options = {
  'batch_connect' => { 'template' => 'basic' },
  'script' => {
    'wall_time' => seconds,
    'native' => {
      'container' => {
        'name' => 'jupyter', 'image' => image,
        'command' => ['bash', '/ood/runner.sh'],
        'working_dir' => '/home/ondemand',
        'restart_policy' => 'Never',
        'port' => 8888, 'cpu' => cores.to_s, 'memory' => "#{gib}Gi",
        'startup_probe' => { 'failure_threshold' => 60, 'period_seconds' => 5 },
        'env' => {
          'HOME' => '/home/ondemand', 'OOD_SESSION_ROOT' => root,
          'OOD_TOKEN' => token, 'OOD_INTERFACE' => mode, 'OOD_SECONDS' => seconds.to_s,
          'OOD_PORTAL_ORIGIN' => origin
        }
      },
      'configmap' => { 'files' => [{
        'filename' => 'runner.sh',
        'data' => File.read('/var/www/ood/apps/sys/jupyter/runner.sh'),
        'mount_path' => '/ood/runner.sh', 'sub_path' => 'runner.sh'
      }] }
    }
  }
}
%><%= YAML.dump(options) %>

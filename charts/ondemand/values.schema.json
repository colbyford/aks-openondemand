{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/:-]*$"},
        "tag": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"}
      }
    },
    "auth": {
      "type": "object",
      "properties": {"existingSecret": {"type": "string", "minLength": 1}}
    },
    "ingress": {
      "type": "object",
      "properties": {
        "className": {"type": "string", "minLength": 1},
        "host": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9.-]*$"},
        "tlsSecret": {"type": "string", "minLength": 1}
      }
    },
    "nfs": {
      "type": "object",
      "properties": {
        "server": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$"},
        "path": {"type": "string", "minLength": 1, "pattern": "^/[A-Za-z0-9_./-]*$"}
      }
    },
    "apps": {
      "type": "object",
      "properties": {
        "jupyterImage": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/:@-]*$"},
        "batchImage": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/:@-]*$"}
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "nodeSubnetCIDR": {"type": "string", "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/([1-9]|[12][0-9]|3[0-2])$"},
        "nodeHostRegex": {"type": "string", "minLength": 3, "pattern": "^[^^$]+$"},
        "apiServerCIDRs": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/([1-9]|[12][0-9]|3[0-2])$"}
        }
      }
    }
  }
}
